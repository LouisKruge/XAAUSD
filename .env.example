# Copy to .env and fill in. NEVER commit .env.
XAUUSD_ENV=dev

# --- datastores -----------------------------------------------------------------------
# POSTGRES_PASSWORD is read by docker-compose.yml; it has no default on purpose, so a
# throwaway password cannot become the production one by inattention.
POSTGRES_PASSWORD=
# XAUUSD_DATABASE__URL is deliberately NOT set here. Left unset, the config files
# decide: dev uses a local SQLite file that needs nothing installed, demo and live
# use PostgreSQL. Setup fills this in with the generated password only when it has
# actually started PostgreSQL for you.
# XAUUSD_DATABASE__URL=

# --- broker ---------------------------------------------------------------------------
XAUUSD_BROKER__LOGIN=
XAUUSD_BROKER__PASSWORD=
XAUUSD_BROKER__SERVER=
XAUUSD_BROKER__TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# --- dashboard ------------------------------------------------------------------------
# The dashboard can halt the engine and flatten every position. It binds to loopback by
# default and needs no token there. Setting a non-loopback host WITHOUT a token is
# refused at startup rather than served — if you need remote access, the recommended
# route is an SSH tunnel or WireGuard with the default bind, not 0.0.0.0.
#   generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
XAUUSD_DASHBOARD__HOST=127.0.0.1
XAUUSD_DASHBOARD__PORT=8000
XAUUSD_DASHBOARD__AUTH_TOKEN=

# --- data and alerts ------------------------------------------------------------------
XAUUSD_DATA__FRED_API_KEY=
XAUUSD_ALERTS__TELEGRAM_BOT_TOKEN=
XAUUSD_ALERTS__TELEGRAM_CHAT_ID=
ANTHROPIC_API_KEY=
