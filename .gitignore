# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage*

# Node / dashboard
node_modules/
dist/
.vite/

# Secrets & local config — NEVER commit
.env
.env.*
!.env.example
config/local.*
secrets/
*.pem
*.key

# The live arming file is KEY 2 of the two-key live-trading arm. It contains the
# account number and is machine-specific by design — committing it would both leak the
# account and let the flag travel to another machine.
config/live_arming.json
live_arming*.json
!config/live_arming.example.json

# Data lake / research artefacts (large, regenerable)
data/lake/
data/raw/
data/cache/
*.parquet
*.duckdb
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Backtest / model outputs
artifacts/
reports/
mlruns/
models/*.pkl
models/*.txt

# Logs
logs/
*.log

# OS / editor
.DS_Store
.idea/
.vscode/
